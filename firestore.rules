rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: get current user's family ID
    function getUserFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    // Helper function: check if user is a parent
    function isParent() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    // Families: parents can create, family members can read
    match /families/{familyId} {
      allow read: if request.auth != null && getUserFamilyId() == familyId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && getUserFamilyId() == familyId && isParent();
    }

    // Users: own profile or same family
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        getUserFamilyId() == resource.data.familyId
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Shopping items: family members can read/add; parents can approve/delete all
    match /shopping/{itemId} {
      allow read: if request.auth != null && getUserFamilyId() == resource.data.familyId;
      allow create: if request.auth != null && getUserFamilyId() == request.resource.data.familyId;
      allow update: if request.auth != null && getUserFamilyId() == resource.data.familyId && (
        isParent() || resource.data.addedBy == request.auth.uid
      );
      allow delete: if request.auth != null && getUserFamilyId() == resource.data.familyId && (
        isParent() || resource.data.addedBy == request.auth.uid
      );
    }

    // Tasks: parents can create/delete; assigned members can update status
    match /tasks/{taskId} {
      allow read: if request.auth != null && getUserFamilyId() == resource.data.familyId;
      allow create: if request.auth != null && getUserFamilyId() == request.resource.data.familyId;
      allow update: if request.auth != null && getUserFamilyId() == resource.data.familyId && (
        isParent() ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if request.auth != null && getUserFamilyId() == resource.data.familyId && (
        isParent() || resource.data.createdBy == request.auth.uid
      );
    }

    // Events: all family members can read/create; creators and parents can edit/delete
    match /events/{eventId} {
      allow read: if request.auth != null && getUserFamilyId() == resource.data.familyId;
      allow create: if request.auth != null && getUserFamilyId() == request.resource.data.familyId;
      allow update, delete: if request.auth != null && getUserFamilyId() == resource.data.familyId && (
        isParent() || resource.data.createdBy == request.auth.uid
      );
    }

    // Announcements: all can read/create; creators and parents can delete
    match /announcements/{annId} {
      allow read: if request.auth != null && getUserFamilyId() == resource.data.familyId;
      allow create: if request.auth != null && getUserFamilyId() == request.resource.data.familyId;
      allow update: if request.auth != null && getUserFamilyId() == resource.data.familyId && isParent();
      allow delete: if request.auth != null && getUserFamilyId() == resource.data.familyId && (
        isParent() || resource.data.createdBy == request.auth.uid
      );
    }
  }
}
