# =============================================
# Family Manager App - Firebase Configuration
# =============================================
# Copy this file to .env.local and fill in your Firebase values.
# Get these from: Firebase Console → Project Settings → Your Apps → SDK setup

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# =============================================
# Setup Guide (free forever - Firebase Spark):
# =============================================
# 1. Go to https://console.firebase.google.com/
# 2. Click "Add project" → name it (e.g. "family-manager") → Create
# 3. Click </> (Web) → Register app → copy the firebaseConfig values above
# 4. Enable in Firebase Console:
#    - Authentication → Sign-in method → Email/Password → Enable
#    - Firestore Database → Create database → Start in production mode → choose region
#    - Hosting → Get started (optional, for free deployment)
# 5. Apply Firestore security rules:
#    → Go to Firestore → Rules tab → paste contents of firestore.rules → Publish
# 6. Rename this file to .env.local and fill in your values
# 7. Run: npm run dev
# =============================================
